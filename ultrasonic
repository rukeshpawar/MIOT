#define trig 8
#define echo 9

long int time;
int distance;

void setup()
{
  pinMode(trig,OUTPUT);
  pinMode(echo,INPUT);
  
  Serial.begin(9600);
}

void loop()
{
  digitalWrite(trig,LOW);
  delayMicroseconds(2);
  digitalWrite(trig,HIGH);
  delayMicroseconds(10);
  digitalWrite(trig,LOW);

  time=pulseIn(echo,HIGH);

  distance=time*0.0343/2;

  Serial.print("Distance:");
  Serial.print(distance);
  Serial.println("cm");
}
