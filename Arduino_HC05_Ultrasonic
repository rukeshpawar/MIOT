
#include <SoftwareSerial.h>

#define trig 8
#define echo 9

long int time;
float distance;

SoftwareSerial BT(10, 11);

void setup()
{
  pinMode(trig, OUTPUT);
  pinMode(echo, INPUT);

  Serial.begin(9600);
  BT.begin(9600);
}

void loop()
{
  digitalWrite(trig, LOW);
  delayMicroseconds(2);

  digitalWrite(trig, HIGH);
  delayMicroseconds(10);

  digitalWrite(trig, LOW);

  time = pulseIn(echo, HIGH);

  distance = time * 0.0343 / 2;

  Serial.print("Distance: ");
  Serial.print(distance);
  Serial.println(" cm");

  BT.print("Distance: ");
  BT.print(distance);
  BT.println(" cm");

  delay(500);
}
